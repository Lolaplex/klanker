# ==============================================================================
# Klanker — Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# LAYER 1: Core Engine & LLM Provider Settings
# ------------------------------------------------------------------------------

# LLM Provider Configuration (OpenAI-compatible endpoints)
# Recommended: OpenRouter, Google Gemini, DeepSeek, OpenAI, Groq, or local LM Studio
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-...
LLM_MODEL=openai/gpt-4o-mini

# Default runner provider ID (corresponds to runner/providers/*.json in harness)
LOOP_PROVIDER=openai.default

# ------------------------------------------------------------------------------
# LAYER 2: I/O Relay Settings (Optional, when using 'klanker serve')
# ------------------------------------------------------------------------------

# Relay HTTP Server (env names GATEWAY_* stay for host compat)
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
GATEWAY_SECRET=replace-with-random-secret-key-32-chars

# Telegram Bot Channel (Optional, polled by agents-relay)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# LAYER 3: CalDAV (core). Desktop prefers ~/.agents/calendar.json (0600).
# VPS / Coolify / klanker serve: set these three. Never commit values.
# ------------------------------------------------------------------------------
CALDAV_URL=
CALDAV_USERNAME=
CALDAV_PASSWORD=

