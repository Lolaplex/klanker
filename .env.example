# ==============================================================================
# Klanker — Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# LAYER 1: Core Engine & LLM Provider Settings
# ------------------------------------------------------------------------------

# LLM Provider Configuration (OpenAI-compatible endpoints)
# Recommended: OpenRouter, Google Gemini, DeepSeek, OpenAI, Groq, or local LM Studio
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-...
LLM_MODEL=openai/gpt-4o-mini

# Default runner provider ID (corresponds to runner/providers/*.json in harness)
LOOP_PROVIDER=openai.default

# ------------------------------------------------------------------------------
# LAYER 2: I/O Relay Settings (Optional, when using 'klanker serve')
# ------------------------------------------------------------------------------

# Relay HTTP Server (env names GATEWAY_* stay for host compat)
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
GATEWAY_SECRET=replace-with-random-secret-key-32-chars

# Telegram Bot Channel (Optional, polled by agents-relay)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_WEBHOOK_SECRET=

# Refuse to poll Telegram when the allowlist is empty unless this is 1.
KLANKER_TELEGRAM_OPEN=

# In-process scheduler. 0 disables the ticker inside `klanker serve`.
KLANKER_TICK=1

# IANA zone for `klanker routine add` when --timezone is omitted, and for harness cron.
# TZ=UTC
# AGENTS_TIMEZONE=UTC

# Channel recorded on schedules created outside a turn. A turn sets this from
# its own --channel (http, telegram, local, …).
# KLANKER_CHANNEL=http

# Images attached to a turn become vision parts when this is 1
# (or when the provider manifest advertises vision). Otherwise the path is text.
# AGENTS_VISION=1

# Approval gate is off by default. `klanker serve` does not set
# AGENTS_APPROVAL_MODE. Unset mode leaves mutating tools ungated.
# Opt in with ask or strict. When that mode is set and AGENTS_APPROVAL_CMD
# is unset, serve fills the default agents-relay approve command.
# AGENTS_APPROVAL_MODE=ask
# AGENTS_APPROVAL_CMD=agents-relay approve --user {user} --timeout 300

# External MCP servers and skills (defaults shown).
# AGENTS_MCP_CONFIG=~/.agents/mcp.json
# AGENTS_SKILLS_DIR=~/.agents/skills

# Expose mutating agents-keys verbs. Default is read-only.
# KLANKER_KEYS_WRITE=1

# ------------------------------------------------------------------------------
# LAYER 3: CalDAV (core). Desktop prefers ~/.agents/calendar.json (0600).
# Host or container env for `klanker serve`. Never commit values.
# ------------------------------------------------------------------------------
CALDAV_URL=
CALDAV_USERNAME=
CALDAV_PASSWORD=

