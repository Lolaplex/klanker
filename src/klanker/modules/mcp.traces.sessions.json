  "mutates": false,
  "parameters": {
    "type": "object",
    "properties": {
      "days": {"type": "string", "description": "Days to look back", "x-cli": "--days"},
      "limit": {"type": "string", "description": "Max sessions", "x-cli": "--limit"}
    }
  }
}
