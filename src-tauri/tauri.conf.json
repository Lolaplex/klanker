{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Klanker",
  "mainBinaryName": "Klanker",
  "version": "0.0.1",
  "identifier": "org.lolaplex.klanker",
  "build": {
    "beforeDevCommand": "pnpm --dir web dev --port 1420",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --dir web build",
    "frontendDist": "../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:* https: http:; img-src 'self' data: blob: https: http:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'self'"
    },
    "windows": [
      {
        "label": "main",
        "title": "Klanker",
        "url": "/",
        "width": 1280,
        "height": 840,
        "minWidth": 800,
        "minHeight": 550,
        "decorations": false,
        "shadow": true,
        "resizable": true,
        "center": true,
        "visible": true,
        "focus": true,
        "dragDropEnabled": false,
        "backgroundColor": "#000000"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_KLANKER_MINISIGN_PUBKEY",
      "endpoints": [
        "https://github.com/Lolaplex/klanker/releases/latest/download/latest.json"
      ]
    }
  }
}
