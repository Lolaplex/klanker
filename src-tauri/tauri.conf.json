{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Klanker",
  "mainBinaryName": "Klanker",
  "version": "0.0.1",
  "identifier": "org.lolaplex.klanker",
  "build": {
    "beforeDevCommand": "pnpm --dir ../web dev --port 1420",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --dir ../web build",
    "frontendDist": "../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Klanker",
        "url": "/",
        "width": 1280,
        "height": 840,
        "minWidth": 800,
        "minHeight": 550,
        "decorations": false,
        "shadow": true,
        "resizable": true,
        "center": true,
        "visible": true,
        "focus": true,
        "dragDropEnabled": false,
        "backgroundColor": "#000000"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
